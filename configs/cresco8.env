# CRESCO8 paths for the backend-comparison experiment. Paths only: no hosts,
# accounts or credentials. Source it before any script:  source configs/cresco8.env

# Persistent models, runtimes, and experiment outputs live in store_0 under its
# project quota. scratch_1 is reserved for regenerable caches and temporary files;
# files there are subject to the cluster's retention policy. sync_results.sh also
# copies experiment results into the local repository.
export BC_STORE="/lpor1/store_0/usr/${USER}"
export BC_SCRATCH="/lpor1/scratch_1/usr/${USER}"
export BC_DATA="${BC_STORE}/projects/backend-comparison" # persistent results and model aliases
export BC_HF_CACHE="${BC_STORE}/models/huggingface"       # HF snapshots (read-only use)
export BC_IMAGES="${BC_STORE}/runtimes/images"            # vLLM SIF images
export BC_LLAMACPP="${BC_STORE}/runtimes/llamacpp-native" # llama.cpp builds (commit 9655061)
export BC_STREAM_BIN="${HOME}/dev/hw-bench/build/stream_triad"
export BC_STREAM_RESULTS="${BC_STORE}/results/hw-roofline"

# Python 3.12 with tomllib (the system python3 is 3.9).
export BC_PYTHON="${BC_STORE}/runtimes/venvs/llm-bench/bin/python"

export SLURM_ACCOUNT="enea"
export APPTAINER_CACHEDIR="${BC_SCRATCH}/cache/apptainer"
export APPTAINER_TMPDIR="${BC_SCRATCH}/cache/apptainer-tmp"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
