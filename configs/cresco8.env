# CRESCO8 paths for the backend-comparison experiment. Paths only: no hosts,
# accounts or credentials. Source it before any script:  source configs/cresco8.env

# Large data lives on Lustre; the AFS home is small. store_0 holds the existing
# inputs (HF snapshots, images, llama.cpp builds) under a 95 GB project quota;
# this experiment's outputs go to scratch_1, which has no quota. Scratch may be
# purged: scripts/cluster/sync_results.sh copies results into the repository.
export BC_STORE="/lpor1/store_0/usr/${USER}"
export BC_SCRATCH="/lpor1/scratch_1/usr/${USER}"
export BC_DATA="${BC_SCRATCH}/backend-comparison"        # results, telemetry, GGUFs
export BC_HF_CACHE="${BC_STORE}/hf-cache"                # existing HF snapshots (read-only use)
export BC_IMAGES="${BC_STORE}/images"                    # existing vLLM SIF images
export BC_LLAMACPP="${BC_STORE}/llamacpp-native"         # existing llama.cpp builds (commit 9655061)
export BC_STREAM_BIN="${HOME}/dev/hw-bench/build/stream_triad"
export BC_STREAM_RESULTS="${BC_STORE}/results/hw-roofline"

# Python 3.12 with tomllib (the system python3 is 3.9).
export BC_PYTHON="${BC_STORE}/venvs/llm-bench/bin/python"

export SLURM_ACCOUNT="enea"
export APPTAINER_CACHEDIR="${BC_STORE}/apptainer-cache"
export APPTAINER_TMPDIR="${BC_STORE}/apptainer-tmp"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
